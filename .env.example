# ==========================================================================
# ToolForge 环境变量示例
# 复制本文件为 .env 并填入真实值；.env 不应提交到版本库
# 没有 OPENAI_API_KEY 时系统自动使用 MockLLM，完整 Demo 仍可运行
# ==========================================================================

# LLM（OpenAI 兼容接口；留空即启用 MockLLM）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 应用
APP_ENV=dev

# 数据与产物目录
DATA_DIR=data
OUTPUT_DIR=output

# 沙箱模式：auto（优先 Docker）| docker | subprocess
SANDBOX_MODE=auto

# 记忆存储（Phase 3 启用）
CHROMA_DIR=.chroma
SQLITE_PATH=data/toolforge.db
TRACES_DIR=data/traces
